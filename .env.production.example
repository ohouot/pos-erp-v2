# Modèle de configuration pour docker-compose.prod.yml — copier en ".env" à
# la racine du dépôt sur le serveur et renseigner de vraies valeurs. Ce
# fichier ne doit jamais être commité avec de vrais secrets (voir .gitignore).

# Nom de domaine pointant vers ce serveur (A/AAAA record) — Caddy y attache
# un certificat HTTPS automatiquement via Let's Encrypt (ports 80/443 requis).
DOMAIN=exemple.com

# ============================
# Base de données
# ============================
DB_USER=posadmin
# Générer avec: openssl rand -base64 24
DB_PASSWORD=changeme_generer_un_mot_de_passe_fort
DB_NAME=pos_erp_v2

# ============================
# API — secrets JWT
# ============================
# Générer chaque secret avec: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme_min_32_caracteres_genere_aleatoirement
JWT_REFRESH_SECRET=changeme_min_32_caracteres_different_du_precedent
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# next-auth (frontend)
# ============================
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_min_32_caracteres

# ============================
# Redis (BullMQ — sauvegardes planifiées)
# ============================
# Pas de variable dédiée ici : REDIS_URL est fixé en dur sur redis://redis:6379
# dans docker-compose.prod.yml (service interne au réseau Docker, pas exposé).

# ============================
# Stockage S3-compatible (MinIO auto-hébergé par défaut — voir service minio
# de docker-compose.prod.yml) : sauvegardes base de données.
# ============================
S3_REGION=us-east-1
S3_BUCKET=pos-erp-v2
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme_generer_un_mot_de_passe_fort

# ============================
# Sauvegardes automatiques (pg_dump/pg_restore via docker exec + BullMQ)
# ============================
BACKUP_SCHEDULE_HOURS=24
BACKUP_RETENTION_COUNT=7

# ============================
# Email (optionnel — laisser vide désactive l'envoi réel)
# ============================
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ============================
# Compte Super Admin initial (créé au premier `prisma:seed`)
# ============================
SEED_SUPER_ADMIN_EMAIL=admin@exemple.com
# Changer immédiatement après la première connexion.
SEED_SUPER_ADMIN_PASSWORD=changeme_mot_de_passe_temporaire
