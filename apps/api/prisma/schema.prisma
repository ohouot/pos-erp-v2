// ============================================================================
// POS/ERP — Schéma Prisma
// Convention : toutes les tables métier portent `establishmentId` (multi-tenant
// à discriminant), sauf les tables globales (User, Role, Permission...).
// Les montants et quantités utilisent Decimal (jamais Float) pour éviter les
// erreurs d'arrondi. Les entités catalogue ont un `deletedAt` (soft delete)
// pour ne jamais casser l'historique des ventes qui les référencent.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" (dev, hors conteneur) + le moteur Alpine/musl utilisé par
  // l'image Docker de production (voir apps/api/Dockerfile) — Alpine 3.19+
  // embarque OpenSSL 3.x, pas la version 1.1 sur laquelle le binaryTarget
  // "linux-musl" générique se base par défaut — + le runtime des fonctions
  // serverless Node.js de Vercel (Amazon Linux, OpenSSL 3.x).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITÉ, AUTHENTIFICATION, RBAC
// ============================================================================

enum Gender {
  MALE
  FEMALE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  // Utilisé uniquement pour choisir un avatar par défaut (silhouette) quand
  // aucune photo n'est téléversée — jamais requis, jamais exploité ailleurs.
  gender       Gender?
  // Hashé comme passwordHash (voir lib/password.ts) — code court permettant
  // de confirmer/journaliser qui a approuvé une action sensible (annulation,
  // remise globale) sans changer de session ni de permissions RBAC.
  pinCodeHash  String?
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Informatif seulement — ne bloque jamais la connexion ni l'usage du
  // compte (voir auth.service.register) : confirme juste que l'adresse a
  // été vérifiée, une fois le lien de confirmation cliqué.
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  ownedEstablishments   Establishment[]        @relation("EstablishmentOwner")
  memberships           UserEstablishment[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordResetToken[]
  emailVerifications    EmailVerificationToken[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  stockMovements        StockMovement[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Super Administrateur, Administrateur, Gérant, Caissier, Serveur, Responsable Stock, Comptable...
  description String?
  isSystem    Boolean  @default(false) // rôles prédéfinis non supprimables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  memberships UserEstablishment[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // ex: "products:create", "cashier:close"
  module      String // ex: "products", "cashier" — pour grouper l'affichage
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Appartenance d'un utilisateur à un établissement, avec un rôle propre à
// cet établissement (un même utilisateur peut être Gérant ici, Caissier ailleurs).
model UserEstablishment {
  id              String   @id @default(cuid())
  userId          String
  establishmentId String
  roleId          String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId], references: [id])

  employeeProfile EmployeeProfile?

  @@unique([userId, establishmentId])
  @@map("user_establishments")
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  createdByIp     String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Même forme que PasswordResetToken — confirmation d'adresse email après
// inscription, jamais bloquante (voir User.emailVerifiedAt).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// ============================================================================
// ÉTABLISSEMENTS & PARAMÈTRES
// ============================================================================

enum EstablishmentType {
  MAQUIS
  LOUNGE
  BAR
  CAVE
  RESTAURANT
  SNACK
  FAST_FOOD
  GLACIER
  CAFE
  HOTEL
}

model Establishment {
  id        String            @id @default(cuid())
  ownerId   String
  name      String
  type      EstablishmentType
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  currency  String            @default("XOF")
  taxRate   Decimal           @default(0) @db.Decimal(5, 2)
  language  String            @default("fr")
  timezone  String            @default("Africa/Abidjan")
  settings  Json? // format d'impression, pied de ticket, préférences diverses
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Compteurs atomiques pour les numérotations séquentielles sans trou
  // (via un `update({ increment: 1 })` en base, jamais un `count()`
  // applicatif — voir Order.invoiceNumber et CashSession.closureNumber).
  nextInvoiceNumber Int @default(1)
  nextClosureNumber Int @default(1)
  // Numéro de file d'attente (accueil client) — remis à 1 au changement de
  // journée commerciale (voir lib/businessDay.ts), pas de trou recherché.
  nextQueueNumber   Int       @default(1)
  queueNumberDate   DateTime?

  owner User @relation("EstablishmentOwner", fields: [ownerId], references: [id])

  members           UserEstablishment[]
  categories        Category[]
  units             Unit[]
  locations         Location[]
  products          Product[]
  suppliers         Supplier[]
  purchases         Purchase[]
  stockMovements    StockMovement[]
  inventorySessions InventorySession[]
  tables            DiningTable[]
  orders            Order[]
  payments          Payment[]
  paymentMethods    PaymentMethod[]
  cashSessions      CashSession[]
  bankAccounts      BankAccount[]
  customers         Customer[]
  discounts         Discount[]
  employeeProfiles  EmployeeProfile[]
  workShifts        WorkShift[]
  attendances       Attendance[]
  reservations      Reservation[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("establishments")
}

// ============================================================================
// CATALOGUE : CATÉGORIES, UNITÉS, PRODUITS
// ============================================================================

model Category {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  description     String?
  imageUrl        String?
  // Couleur de tuile pour le filtre famille en caisse (ex: "#F59E0B") —
  // purement visuel, un fond neutre s'applique si non renseignée.
  color           String?
  parentId        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children      Category[]    @relation("CategoryToSubcategory")
  products      Product[]

  @@unique([establishmentId, name])
  @@map("categories")
}

// Unité de mesure (Pièce, Kg, g, L, cl, Carton, Casier, Bouteille, Canette...).
// establishmentId = null -> unité système partagée par tous ; sinon unité
// personnalisée propre à un établissement.
model Unit {
  id              String  @id @default(cuid())
  establishmentId String?
  name            String
  symbol          String

  establishment Establishment?     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  productsBase  Product[]          @relation("ProductBaseUnit")
  productUnits  ProductUnit[]
  recipeItems   RecipeIngredient[]
  purchaseItems PurchaseItem[]

  @@unique([establishmentId, name])
  @@map("units")
}

// Emplacement de stock (ex: "Cave A, étagère 3") — promu en relation
// propre plutôt qu'un champ texte libre, pour un menu déroulant réutilisable
// et un raccourci de création rapide depuis la fiche produit.
model Location {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      Product[]

  @@unique([establishmentId, name])
  @@map("locations")
}

model Product {
  id              String    @id @default(cuid())
  establishmentId String
  categoryId      String
  name            String
  description     String?
  imageUrl        String?
  barcode         String?
  baseUnitId      String // unité dans laquelle le stock est compté (ex: cl, g, pièce)
  purchasePrice   Decimal   @default(0) @db.Decimal(12, 2)
  salePrice       Decimal   @default(0) @db.Decimal(12, 2)
  // Niveaux de prix additionnels optionnels (ex: happy hour, tarif VIP),
  // sélectionnables à la vente en plus du prix standard — voir
  // orders.service.resolveItem. Null = niveau non configuré pour ce
  // produit, la vente retombe alors sur salePrice.
  salePrice2      Decimal?  @db.Decimal(12, 2)
  salePrice3      Decimal?  @db.Decimal(12, 2)
  // Plancher de prix : jamais un niveau sélectionnable en caisse (voir
  // salePrice/2/3 ci-dessus), sert uniquement à plafonner les remises de
  // ligne à la vente (voir orders.service.assertAboveMinPrice). Null =
  // aucun plancher, la vente ne vérifie rien.
  minSalePrice    Decimal?  @db.Decimal(12, 2)
  taxRate         Decimal   @default(0) @db.Decimal(5, 2)
  currentStock    Decimal   @default(0) @db.Decimal(14, 3) // exprimé en baseUnit
  minStock        Decimal   @default(0) @db.Decimal(14, 3)
  // Pertinent pour la Cave (vins) et la fraîcheur en bar — simple champ
  // produit, pas de suivi par lot de réception (aucun besoin exprimé pour
  // ça, voir ROADMAP).
  expirationDate  DateTime?
  locationId      String? // emplacement de stock (voir model Location)
  preferredSupplierId String? // fournisseur par défaut, informatif (chaque bon de commande choisit son propre fournisseur)
  // Faux pour un article de service (ex: "Bouchon", "Corkage") : ignore
  // entièrement le contrôle de disponibilité et le décrément de stock
  // (voir stock/stockDeduction.service.ts).
  manageStock     Boolean   @default(true)
  // Masque le produit du grid caisse sans le désactiver (reste visible
  // catalogue/achats/rapports) — distinct d'isActive.
  visibleAtPos    Boolean   @default(true)
  // Masque le produit du sélecteur produit des bons de commande fournisseur
  // (voir PurchaseForm côté web) — distinct de visibleAtPos.
  visibleOnPurchaseOrder Boolean @default(true)
  // Dormant tant qu'aucun module boutique en ligne n'existe (voir ROADMAP) —
  // conservé quand même, décision explicite de l'utilisateur.
  visibleOnlineStore     Boolean @default(false)
  isComposed      Boolean   @default(false) // vrai si le produit a une recette (Mojito, Pizza...)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category          Category      @relation(fields: [categoryId], references: [id])
  baseUnit          Unit          @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  location          Location?     @relation(fields: [locationId], references: [id])
  preferredSupplier Supplier?     @relation(fields: [preferredSupplierId], references: [id])

  packagingUnits ProductUnit[]
  recipe         Recipe?            @relation("ComposedProduct")
  usedInRecipes  RecipeIngredient[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@unique([establishmentId, barcode])
  @@index([establishmentId, name])
  @@map("products")
}

// Unités d'achat/vente alternatives pour un produit, avec facteur de
// conversion vers l'unité de base du stock.
// Ex: Product "Bière" en baseUnit=Bouteille ; ProductUnit(Casier, factor=24,
// isPurchaseUnit=true) permet d'acheter par casier tout en stockant en bouteilles.
model ProductUnit {
  id               String  @id @default(cuid())
  productId        String
  unitId           String
  conversionToBase Decimal @db.Decimal(14, 4) // 1 de cette unité = X unités de base
  isPurchaseUnit   Boolean @default(false)
  isSaleUnit       Boolean @default(false)
  barcode          String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@map("product_units")
}

// ============================================================================
// PRODUITS COMPOSÉS / RECETTES (BOM)
// ============================================================================

model Recipe {
  id        String   @id @default(cuid())
  productId String   @unique // le produit vendu (ex: Mojito, Pizza Margherita)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     Product            @relation("ComposedProduct", fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id                  String  @id @default(cuid())
  recipeId            String
  ingredientProductId String
  unitId              String
  quantity            Decimal @db.Decimal(14, 4)

  recipe            Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProduct Product @relation(fields: [ingredientProductId], references: [id])
  unit              Unit    @relation(fields: [unitId], references: [id])

  @@unique([recipeId, ingredientProductId])
  @@map("recipe_ingredients")
}

// ============================================================================
// FOURNISSEURS & ACHATS (APPROVISIONNEMENT)
// ============================================================================

model Supplier {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  establishment    Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  preferredProducts Product[]

  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

model Purchase {
  id              String         @id @default(cuid())
  establishmentId String
  supplierId      String
  employeeId      String // utilisateur ayant enregistré l'achat
  invoiceNumber   String?
  purchaseDate    DateTime       @default(now())
  observation     String?
  totalAmount     Decimal        @default(0) @db.Decimal(14, 2)
  status          PurchaseStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@map("purchases")
}

// Lors de la validation d'un Purchase : chaque PurchaseItem génère un
// StockMovement de type PURCHASE_IN et augmente Product.currentStock.
model PurchaseItem {
  id                 String   @id @default(cuid())
  purchaseId         String
  productId          String
  unitId             String // unité dans laquelle l'achat est exprimé (ex: Casier)
  quantity           Decimal  @db.Decimal(14, 3)
  purchasePrice      Decimal  @db.Decimal(12, 2) // prix unitaire dans l'unité d'achat
  suggestedSalePrice Decimal? @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])

  @@map("purchase_items")
}

// ============================================================================
// STOCK : MOUVEMENTS & INVENTAIRE
// ============================================================================

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RECIPE_CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INVENTORY_CORRECTION
  TRANSFER_IN
  TRANSFER_OUT
}

// Historique immuable : jamais mis à jour, seulement inséré. C'est la source
// de vérité pour la traçabilité complète des stocks.
model StockMovement {
  id              String            @id @default(cuid())
  establishmentId String
  productId       String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(14, 3) // toujours positive, le "type" indique le sens
  quantityBefore  Decimal           @db.Decimal(14, 3)
  quantityAfter   Decimal           @db.Decimal(14, 3)
  referenceType   String? // "PURCHASE" | "ORDER" | "INVENTORY" | "MANUAL"
  referenceId     String?
  employeeId      String?
  reason          String?
  createdAt       DateTime          @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  employee      User?         @relation(fields: [employeeId], references: [id])

  @@index([establishmentId, productId, createdAt])
  @@map("stock_movements")
}

enum InventorySessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InventorySession {
  id              String                 @id @default(cuid())
  establishmentId String
  employeeId      String
  status          InventorySessionStatus @default(IN_PROGRESS)
  notes           String?
  startedAt       DateTime               @default(now())
  completedAt     DateTime?

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  items         InventoryItem[]

  @@map("inventory_sessions")
}

model InventoryItem {
  id                  String  @id @default(cuid())
  inventorySessionId  String
  productId           String
  theoreticalQuantity Decimal @db.Decimal(14, 3)
  realQuantity        Decimal @db.Decimal(14, 3)
  difference          Decimal @db.Decimal(14, 3)
  notes               String?

  inventorySession InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@unique([inventorySessionId, productId])
  @@map("inventory_items")
}

// ============================================================================
// PLAN DE SALLE / TABLES
// ============================================================================

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLEANING
}

model DiningTable {
  id              String      @id @default(cuid())
  establishmentId String
  name            String // ex: "Table 12", "Terrasse 3"
  capacity        Int         @default(4)
  zone            String? // ex: "Terrasse", "Salle intérieure", "VIP"
  status          TableStatus @default(FREE)
  positionX       Int         @default(0)
  positionY       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orderTables   OrderTable[]
  reservations  Reservation[]

  @@unique([establishmentId, name])
  @@map("dining_tables")
}

// ============================================================================
// COMMANDES
// ============================================================================

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model Order {
  id                  String        @id @default(cuid())
  establishmentId     String
  orderNumber         String
  // Numéro de facture séquentiel sans trou, attribué uniquement au passage
  // en PAID (voir payments.service.assignInvoiceNumber) — jamais à la
  // création, contrairement à orderNumber qui n'est qu'une référence de
  // travail pour le personnel avant paiement.
  invoiceNumber       String?
  // Identifiant généré côté client (caisse hors ligne, voir
  // apps/web/src/lib/offlineDb.ts) : rejoue idempotent d'une synchronisation
  // après une commande déjà reçue côté serveur (réponse perdue) sans créer
  // de doublon — voir orders.service.createOrder.
  clientTicketId      String?
  // Session de caisse ouverte au moment de la création de la commande,
  // figée une fois pour toutes — jamais déduite après coup par comparaison
  // de dates (même principe que Payment.cashSessionId). Nullable : une
  // commande peut être créée sans session ouverte (ex: préparation en
  // amont du service).
  cashSessionId       String?
  customerId          String?
  employeeId          String // serveur/caissier ayant pris la commande
  // Responsable rattaché à la vente, distinct du caissier qui encaisse
  // (employeeId) — ex: le gérant qui a autorisé une remise exceptionnelle.
  // Simple champ scalaire optionnel, même pattern qu'employeeId.
  administratorId     String?
  status              OrderStatus   @default(OPEN)
  orderType           OrderType     @default(DINE_IN)
  subtotal            Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(14, 2)
  // Remise sur le ticket entier, distincte des remises par ligne (déjà
  // agrégées dans discountAmount) — appliquée après elles, sur le total
  // TTC déjà calculé. Voir orders.pricing.applyGlobalDiscount.
  globalDiscountType  DiscountType?
  globalDiscountValue Decimal?      @db.Decimal(12, 2)
  totalAmount         Decimal       @default(0) @db.Decimal(14, 2)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  closedAt            DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id])
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id])

  items       OrderItem[]
  orderTables OrderTable[]
  payments    Payment[]

  @@unique([establishmentId, orderNumber])
  @@unique([establishmentId, invoiceNumber])
  @@unique([establishmentId, clientTicketId])
  @@map("orders")
}

// Table de jointure : permet une commande sur plusieurs tables fusionnées.
model OrderTable {
  orderId String
  tableId String

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table DiningTable @relation(fields: [tableId], references: [id])

  @@id([orderId, tableId])
  @@map("order_tables")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  // Libellé et coût d'achat du produit figés au moment de l'ajout de la
  // ligne (voir orders.service.resolveItem) — nullable : les lignes créées
  // avant l'introduction de ce champ n'ont pas cette information a
  // posteriori, seules les nouvelles lignes la renseignent.
  productName    String?
  unitCost       Decimal?        @db.Decimal(12, 2)
  quantity       Decimal         @db.Decimal(14, 3)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal         @db.Decimal(14, 2)
  status         OrderItemStatus @default(PENDING)
  notes          String?
  createdAt      DateTime        @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================================================
// PAIEMENTS & CAISSE
// ============================================================================

// Remplace l'ancien enum PaymentMethod figé : liste configurable par
// établissement (ajout/renommage/désactivation/ordre d'affichage), voir
// modules/paymentMethods. `code` reste stable (utilisé par les rapports/
// intégrations), `label` est le texte affiché et modifiable librement.
model PaymentMethod {
  id              String  @id @default(cuid())
  establishmentId String
  code            String
  label           String
  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@unique([establishmentId, code])
  @@map("payment_methods")
}

// Un Order peut avoir plusieurs Payment (paiement mixte = plusieurs lignes,
// une par méthode, dont la somme égale le total de la commande).
model Payment {
  id              String   @id @default(cuid())
  establishmentId String
  orderId         String
  cashSessionId   String?
  paymentMethodId String
  amount          Decimal  @db.Decimal(14, 2)
  amountReceived  Decimal? @db.Decimal(14, 2)
  changeGiven     Decimal? @db.Decimal(14, 2)
  reference       String? // référence transaction mobile money / CB
  employeeId      String
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id])
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("payments")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id                     String            @id @default(cuid())
  establishmentId        String
  employeeId             String
  openingBalance         Decimal           @db.Decimal(14, 2)
  closingBalanceExpected Decimal?          @db.Decimal(14, 2)
  closingBalanceCounted  Decimal?          @db.Decimal(14, 2)
  difference             Decimal?          @db.Decimal(14, 2)
  status                 CashSessionStatus @default(OPEN)
  notes                  String?
  openedAt               DateTime          @default(now())
  closedAt               DateTime?
  // Numéro de clôture séquentiel sans trou, attribué une seule fois à la
  // fermeture (même compteur atomique que Order.invoiceNumber, voir
  // Establishment.nextClosureNumber).
  closureNumber          Int?
  // Snapshot figé des agrégats au moment de la clôture (détail des ventes
  // par méthode de paiement, nombre de tickets, plage de factures...) —
  // voir cashier.service.closeSession. Écrit une seule fois, jamais
  // recalculé après coup : aucune fonction de mise à jour n'existe pour ce
  // champ une fois la session fermée.
  summary                Json?

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  payments      Payment[]
  movements     CashMovement[]
  orders        Order[]

  @@unique([establishmentId, closureNumber])
  @@map("cash_sessions")
}

enum CashMovementType {
  DEPOSIT
  WITHDRAWAL
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  type          CashMovementType
  amount        Decimal          @db.Decimal(14, 2)
  reason        String?
  employeeId    String
  createdAt     DateTime         @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

// ============================================================================
// BANQUE
// ============================================================================

// Compte bancaire (ou mobile money) suivi séparément de la caisse espèces —
// pas de notion de session/ouverture-fermeture, juste un solde courant et un
// journal de mouvements (même logique de trésorerie qu'un compte réel).
model BankAccount {
  id              String   @id @default(cuid())
  establishmentId String
  name            String // ex: "Compte courant SGBCI", "Wave Business"
  currentBalance  Decimal  @default(0) @db.Decimal(14, 2)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  movements     BankMovement[]

  @@map("bank_accounts")
}

enum BankMovementType {
  DEPOSIT
  WITHDRAWAL
}

model BankMovement {
  id            String           @id @default(cuid())
  bankAccountId String
  type          BankMovementType
  amount        Decimal          @db.Decimal(14, 2)
  reason        String?
  employeeId    String
  createdAt     DateTime         @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("bank_movements")
}

// ============================================================================
// CLIENTS & REMISES
// ============================================================================

model Customer {
  id              String    @id @default(cuid())
  establishmentId String
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  address         String?
  loyaltyPoints   Int       @default(0)
  totalSpent      Decimal   @default(0) @db.Decimal(14, 2)
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
  reservations  Reservation[]

  @@map("customers")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id              String       @id @default(cuid())
  establishmentId String
  name            String
  type            DiscountType
  value           Decimal      @db.Decimal(12, 2)
  code            String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, code])
  @@map("discounts")
}

// ============================================================================
// EMPLOYÉS : PROFIL RH, PLANNING, PRÉSENCE
// ============================================================================

model EmployeeProfile {
  id                  String    @id @default(cuid())
  userEstablishmentId String    @unique
  establishmentId     String
  position            String?
  salary              Decimal?  @db.Decimal(12, 2)
  hireDate            DateTime?
  contractType        String? // CDI, CDD, Stage, Journalier...
  notes               String?
  // Code court identifiant le vendeur/caissier (ex. sur un ticket ou pour un
  // pointage rapide) — distinct de l'email/mot de passe de connexion, unique
  // par établissement seulement (la même personne peut avoir un code
  // différent d'un établissement à l'autre).
  vendorCode          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userEstablishment UserEstablishment @relation(fields: [userEstablishmentId], references: [id], onDelete: Cascade)
  establishment     Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, vendorCode])
  @@map("employee_profiles")
}

model WorkShift {
  id              String   @id @default(cuid())
  establishmentId String
  employeeId      String
  startTime       DateTime
  endTime         DateTime
  role            String? // rôle occupé pendant ce shift (ex: "Caisse", "Salle")
  notes           String?
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, employeeId, startTime])
  @@map("work_shifts")
}

model Attendance {
  id              String    @id @default(cuid())
  establishmentId String
  employeeId      String
  date            DateTime  @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  notes           String?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, employeeId, date])
  @@map("attendances")
}

// ============================================================================
// RÉSERVATIONS
// ============================================================================

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Reservation {
  id              String            @id @default(cuid())
  establishmentId String
  customerId      String?
  tableId         String?
  reservationDate DateTime          @db.Date
  startTime       DateTime
  endTime         DateTime?
  partySize       Int               @default(1)
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id])
  table         DiningTable?  @relation(fields: [tableId], references: [id])

  @@index([establishmentId, reservationDate])
  @@map("reservations")
}

// ============================================================================
// DÉPENSES & COMPTABILITÉ
// (Les rapports de bénéfices/marges/trésorerie sont calculés à partir de
// Order/Payment/Purchase/Expense — pas de tables dédiées supplémentaires.)
// ============================================================================

model ExpenseCategory {
  id              String @id @default(cuid())
  establishmentId String
  name            String // Eau, Électricité, Salaires, Internet, Transport, Divers...

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  expenses      Expense[]

  @@unique([establishmentId, name])
  @@map("expense_categories")
}

model Expense {
  id              String   @id @default(cuid())
  establishmentId String
  categoryId      String
  amount          Decimal  @db.Decimal(14, 2)
  description     String?
  expenseDate     DateTime @default(now())
  employeeId      String
  receiptUrl      String?
  createdAt       DateTime @default(now())

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id              String   @id @default(cuid())
  establishmentId String
  userId          String? // null = diffusée à tout l'établissement
  type            String // "LOW_STOCK" | "NEW_ORDER" | "INVENTORY_DUE" | ...
  title           String
  message         String
  data            Json?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([establishmentId, userId, isRead])
  @@map("notifications")
}

// ============================================================================
// AUDIT
// ============================================================================

model AuditLog {
  id              String   @id @default(cuid())
  establishmentId String?
  userId          String?
  action          String // ex: "PRODUCT_UPDATED", "CASH_SESSION_CLOSED"
  entityType      String
  entityId        String?
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  establishment Establishment? @relation(fields: [establishmentId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])

  @@index([establishmentId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
