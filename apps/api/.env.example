DATABASE_URL="postgresql://posadmin:posadmin_dev_password@localhost:5433/pos_erp_v2?schema=public"

PORT=4100
NODE_ENV=development
CLIENT_URL=http://localhost:3100

JWT_ACCESS_SECRET=changeme_access_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pos-erp-v2
S3_ACCESS_KEY_ID=posadmin
S3_SECRET_ACCESS_KEY=posadmin_dev_password
S3_FORCE_PATH_STYLE=true

SEED_SUPER_ADMIN_EMAIL=admin@pos-erp-v2.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Optionnel — laisser vide désactive l'envoi d'email réel, voir §B du plan
# (Nodemailer + transport SMTP Resend). Clé API depuis resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optionnel — laisser vide désactive la supervision d'erreurs.
SENTRY_DSN=

# Optionnel — laisser vide utilise Socket.io (chemin VPS/Docker, valeur par
# défaut). Renseigner bascule l'émission temps réel serveur vers Ably (chemin
# serverless) — voir apps/api/src/realtime/realtime.service.ts.
ABLY_API_KEY=

# Sauvegardes base de données (pg_dump/pg_restore via docker exec, stockées
# sur S3_* ci-dessus) — voir apps/api/src/backups/.
BACKUP_DB_CONTAINER=pos-erp-v2-postgres
BACKUP_SCHEDULE_HOURS=24
BACKUP_RETENTION_COUNT=7
